<mxfile host="app.diagrams.net"><diagram name="fig-4-7-schema" id="fig-4-7-schema"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1300" pageHeight="720" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;p style=&quot;margin:4px 0;text-align:center;&quot;&gt;&lt;b&gt;sessions&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 6px 4px;text-align:left;&quot;&gt;session_id             TEXT  PK&lt;br&gt;created_at             TEXT  NOT NULL&lt;br&gt;transcript             TEXT  NOT NULL, not blank&lt;br&gt;transcript_approved_by TEXT  NOT NULL&lt;br&gt;finalized_by           TEXT  NOT NULL&lt;br&gt;draft_source           TEXT  model | manual&lt;br&gt;assessment_origin      TEXT  clinician_manual |&lt;br&gt;                             clinician_edited |&lt;br&gt;                             ai_text_accepted_verbatim&lt;br&gt;allergies_confirmed    INT   CHECK = 1&lt;br&gt;medications_confirmed  INT   CHECK = 1&lt;br&gt;negatives_confirmed    INT   CHECK = 1&lt;br&gt;generation_attempts    INT   &amp;gt;= 0&lt;br&gt;guardrail_flags        TEXT  JSON list&lt;br&gt;asr_model              TEXT&lt;br&gt;model_version          TEXT&lt;br&gt;transcript_language    TEXT  (v4)&lt;br&gt;asr_confidence         REAL  0 to 1 (v4)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="470" height="330" as="geometry"/></mxCell><mxCell id="c2" value="&lt;p style=&quot;margin:4px 0;text-align:center;&quot;&gt;&lt;b&gt;notes&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 6px 4px;text-align:left;&quot;&gt;session_id  TEXT  PK, FK sessions&lt;br&gt;kind        TEXT  PK: model_draft |&lt;br&gt;                  clinician_final&lt;br&gt;subjective  TEXT&lt;br&gt;objective   TEXT&lt;br&gt;assessment  TEXT  not blank when final&lt;br&gt;plan        TEXT&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="20" width="360" height="154" as="geometry"/></mxCell><mxCell id="c3" value="&lt;p style=&quot;margin:4px 0;text-align:center;&quot;&gt;&lt;b&gt;suggestions&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 6px 4px;text-align:left;&quot;&gt;session_id  TEXT  PK, FK sessions&lt;br&gt;position    INT   PK, &amp;gt;= 0&lt;br&gt;rank        INT&lt;br&gt;diagnosis   TEXT&lt;br&gt;rationale   TEXT&lt;br&gt;management  TEXT&lt;br&gt;accepted    INT   0 | 1&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="230" width="360" height="154" as="geometry"/></mxCell><mxCell id="c4" value="&lt;p style=&quot;margin:4px 0;text-align:center;&quot;&gt;&lt;b&gt;users&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 6px 4px;text-align:left;&quot;&gt;user_id              TEXT  PK&lt;br&gt;username             TEXT  UNIQUE, NOCASE&lt;br&gt;display_name         TEXT&lt;br&gt;role                 TEXT  clinician | admin&lt;br&gt;password_hash        TEXT  $argon2id$...&lt;br&gt;failed_attempts      INT   &amp;gt;= 0&lt;br&gt;locked_until         TEXT&lt;br&gt;active               INT   0 | 1&lt;br&gt;created_at           TEXT&lt;br&gt;must_change_password INT   0 | 1 (v3)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="20" width="350" height="202" as="geometry"/></mxCell><mxCell id="c5" value="&lt;p style=&quot;margin:4px 0;text-align:center;&quot;&gt;&lt;b&gt;audit_logs&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 6px 4px;text-align:left;&quot;&gt;seq         INT   PK, &amp;gt;= 1&lt;br&gt;ts          TEXT  NOT NULL&lt;br&gt;event       TEXT  NOT NULL&lt;br&gt;session_id  TEXT  NOT NULL&lt;br&gt;user_id     TEXT&lt;br&gt;prev_hash   TEXT  64 hex characters&lt;br&gt;entry_hash  TEXT  64 hex, UNIQUE&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#333333;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="300" width="350" height="154" as="geometry"/></mxCell><mxCell id="c6" value="SQLCipher-encrypted SQLite file. CHECK constraints refuse a note without the checklist or a clinician's assessment, even if the program were bypassed. ON DELETE CASCADE removes a session's notes and suggestions with it." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="900" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>